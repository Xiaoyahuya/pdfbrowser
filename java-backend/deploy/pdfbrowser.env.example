PDFBROWSER_ROOT=/home/lfp/pdfbrowser/google-drive
PORT=8082
PDFBROWSER_MAX_MARKDOWN_BYTES=2097152
PDFBROWSER_READ_ONLY=true
PDFBROWSER_HTPASSWD_FILE=/etc/nginx/pdfbrowser-auth/htpasswd
PDFBROWSER_MAX_UPLOAD_BYTES=104857600
PDFBROWSER_SEARCH_MAX_DEPTH=8
PDFBROWSER_SEARCH_MAX_RESULTS=200
PDFBROWSER_NAS_ENABLED=true
PDFBROWSER_NAS_RUNTIME=/home/lfp/pdfbrowser/nas-runtime
# 运行 install-nas-runtime.sh 自动生成；不要把真实密钥提交到仓库。
PDFBROWSER_NAS_CREDENTIAL_KEY=BASE64_ENCODED_32_BYTE_KEY
PDFBROWSER_NAS_ALLOW_PUBLIC_HOSTS=false
PDFBROWSER_NAS_MOUNT_TIMEOUT_SECONDS=20
PDFBROWSER_NAS_SOCKS_HOST=127.0.0.1
PDFBROWSER_NAS_SOCKS_PORT=7897

    },
    {
      "id": "text_0139",
      "type": "text",
      "x": 184,
      "y": 1346.35,
      "width": 672,
      "height": 81.92,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
